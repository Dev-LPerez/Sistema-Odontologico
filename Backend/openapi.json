            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Consultar detalle de un paciente por ID",
        "tags": [
          "Patients"
        ]
      },
      "patch": {
        "operationId": "PatientsController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePatientDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paciente actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Actualizar datos demográficos de un paciente",
        "tags": [
          "Patients"
        ]
      }
    },
    "/v1/patients/{id}/status": {
      "patch": {
        "operationId": "PatientsController_changeStatus",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePatientStatusDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Estado del paciente actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Cambiar estado activo/inactivo del paciente (solo ADMIN)",
        "tags": [
          "Patients"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "HealthController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Servidor activo en memoria"
          }
        },
        "summary": "Liveness probe (comprueba si el proceso está activo)",
        "tags": [
          "Health"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "HealthController_getReady",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Base de datos disponible"
          },
          "503": {
            "description": "Base de datos no disponible"
          }
        },
        "summary": "Readiness probe (comprueba conectividad con PostgreSQL)",
        "tags": [
          "Health"
        ]
      }
    }
  },
  "info": {
    "title": "Sistema Odontológico API",
    "description": "API REST del Sistema de Gestión para Consultorio Odontológico",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Correo electrónico del usuario",
            "example": "doctora@clinica.com"
          },
          "password": {
            "type": "string",
            "description": "Contraseña en texto plano",
            "example": "Admin12345!",
            "minLength": 6
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UserProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "b0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"
          },
          "clinicId": {
            "type": "string",
            "example": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a22"
          },
          "email": {
            "type": "string",
            "example": "doctora@clinica.com"
          },
          "fullName": {
            "type": "string",
            "example": "Dra. María Pérez"
          },
          "role": {
            "type": "string",
            "example": "ADMIN",
            "enum": [
              "ADMIN",
              "AUXILIARY"
            ]
          }
        },
        "required": [
          "id",
          "clinicId",
          "email",
          "fullName",
          "role"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserProfileDto"
          },
          "accessToken": {
            "type": "string",
            "description": "Token de acceso JWT de corta duración (15 min)",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        "required": [
          "user",
          "accessToken"
        ]
      },
      "RefreshResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserProfileDto"
          },
          "accessToken": {
            "type": "string",
            "description": "Nuevo token de acceso JWT tras la rotación de sesión",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        "required": [
          "user",
          "accessToken"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "b0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"
          },
          "clinicId": {
            "type": "string",
            "example": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a22"
          },
          "email": {
            "type": "string",
            "example": "auxiliar@consultorio.com"
          },
          "fullName": {
            "type": "string",
            "example": "Laura Gómez"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "AUXILIARY"
            ],
            "example": "AUXILIARY"
          },
          "isActive": {
            "type": "boolean",
            "example": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-10-13T10:00:00.000Z"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-10-13T10:00:00.000Z"
          }
        },
        "required": [
          "id",
          "clinicId",
          "email",
          "fullName",
          "role",
          "isActive",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Correo electrónico único del nuevo usuario",
            "example": "auxiliar@consultorio.com"
          },
          "password": {
            "type": "string",
            "description": "Contraseña de acceso inicial (mínimo 8 caracteres)",
            "example": "SecurePassword123!",
            "minLength": 8
          },
          "fullName": {
            "type": "string",
            "description": "Nombre completo del usuario",
            "example": "Laura Gómez"
          },
          "role": {
            "type": "string",
            "description": "Rol asignado al usuario dentro del consultorio",
            "enum": [
              "ADMIN",
              "AUXILIARY"
            ],
            "example": "AUXILIARY"
          }
        },
        "required": [
          "email",
          "password",
          "fullName",
          "role"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "description": "Nombre completo actualizado",
            "example": "Laura Gómez Martínez"
          },
          "email": {
            "type": "string",
            "description": "Nuevo correo electrónico",
            "example": "laura.nueva@consultorio.com"
          },
          "role": {
            "type": "string",
            "description": "Rol actualizado en el consultorio",
            "enum": [
              "ADMIN",
              "AUXILIARY"
            ],
            "example": "AUXILIARY"
          },
          "password": {
            "type": "string",
            "description": "Nueva contraseña (opcional)",
            "example": "NewSecurePass2026!",
            "minLength": 8
          }
        }
      },
      "ChangeUserStatusDto": {
        "type": "object",
        "properties": {
          "isActive": {
            "type": "boolean",
            "description": "Nuevo estado activo o inactivo del usuario",
            "example": false
          }
        },
        "required": [
          "isActive"
        ]
      },
      "ClinicProfileResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a22"
          },
          "name": {
            "type": "string",
