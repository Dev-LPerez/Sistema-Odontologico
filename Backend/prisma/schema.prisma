generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, uuid_ossp(map: "uuid-ossp"), unaccent]
}

model SystemCheck {
  id        String   @id @default(uuid())
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("system_checks")
}

enum UserRole {
  ADMIN
  AUXILIARY
}

model Clinic {
  id                     String                  @id @default(uuid())
  name                   String
  address                String?
  phone                  String?
  email                  String?
  logoUrl                String?                 @map("logo_url")
  settings               Json?
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  users                  User[]
  refreshSessions        RefreshSession[]
  patients               Patient[]
  procedures             Procedure[]
  patientProcedurePrices PatientProcedurePrice[]
  materials              Material[]
  clinicalHistories      ClinicalHistory[]
  treatmentPlanItems     TreatmentPlanItem[]
  odontograms            Odontogram[]
  odontogramSnapshots    OdontogramSnapshot[]
  clinicalAttentions     ClinicalAttention[]
  attentionMaterialsUsed AttentionMaterialUsed[]

  @@map("clinics")
}

model User {
  id              String           @id @default(uuid())
  clinicId        String           @map("clinic_id")
  email           String           @unique
  passwordHash    String           @map("password_hash")
  fullName        String           @map("full_name")
  role            UserRole
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  clinic          Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  refreshSessions RefreshSession[]
  clinicalAttentions ClinicalAttention[]

  @@index([clinicId, role])
  @@map("users")
}

model RefreshSession {
  id        String    @id @default(uuid())
  clinicId  String    @map("clinic_id")
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  clinic    Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([clinicId])
  @@map("refresh_sessions")
}

enum DocumentType {
  CC
  TI
  RC
  CE
  PAS
  OTHER
}

enum AcquisitionSource {
  REFERRAL
  INSTAGRAM
  WHATSAPP
  DIRECT
  OTHER
}

model Patient {
  id                     String            @id @default(uuid())
  clinicId               String            @map("clinic_id")
  firstName              String            @map("first_name")
  lastName               String            @map("last_name")
  documentType           DocumentType      @map("document_type")
  documentNumber         String            @map("document_number")
  birthDate              DateTime          @map("birth_date")
  phone                  String
  email                  String?
  address                String?
  emergencyContactName   String?           @map("emergency_contact_name")
  emergencyContactPhone  String?           @map("emergency_contact_phone")
  acquisitionSource      AcquisitionSource @default(DIRECT) @map("acquisition_source")
  dataTreatmentConsent   Boolean           @map("data_treatment_consent")
  dataTreatmentConsentAt DateTime          @map("data_treatment_consent_at")
  isActive               Boolean           @default(true) @map("is_active")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  clinic            Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  procedurePrices   PatientProcedurePrice[]
  clinicalHistories   ClinicalHistory[]
  odontograms         Odontogram[]
  odontogramSnapshots OdontogramSnapshot[]
  clinicalAttentions  ClinicalAttention[]

  @@unique([clinicId, documentType, documentNumber])
  @@index([clinicId, isActive])
  @@index([clinicId, phone])
  @@map("patients")
}

model Procedure {
  id            String                  @id @default(uuid())
  clinicId      String                  @map("clinic_id")
  code          String
  name          String
  description   String?
  basePriceCop  Int                     @map("base_price_cop")
  isActive      Boolean                 @default(true) @map("is_active")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")
  clinic             Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patientPrices      PatientProcedurePrice[]
  treatmentPlanItems TreatmentPlanItem[]

  @@unique([clinicId, code])
  @@index([clinicId, isActive])
  @@map("procedures")
}

model PatientProcedurePrice {
  id             String    @id @default(uuid())
  clinicId       String    @map("clinic_id")
  patientId      String    @map("patient_id")
  procedureId    String    @map("procedure_id")
  customPriceCop Int       @map("custom_price_cop")
  reason         String
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  clinic         Clinic    @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  procedure      Procedure @relation(fields: [procedureId], references: [id], onDelete: Restrict)

  @@unique([clinicId, patientId, procedureId])
  @@index([clinicId, patientId])
  @@map("patient_procedure_prices")
}

model Material {
  id           String   @id @default(uuid())
  clinicId     String   @map("clinic_id")
  brand        String
  reference    String
  type         String
  color        String
  currentStock Int      @map("current_stock")
  minStock     Int      @map("min_stock")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  clinic                 Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  attentionMaterialsUsed AttentionMaterialUsed[]

  @@unique([clinicId, brand, reference, color])
  @@index([clinicId, isActive])
  @@map("materials")
}

enum TreatmentItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model ClinicalHistory {
  id                  String              @id @default(uuid())
  clinicId            String              @map("clinic_id")
  patientId           String              @map("patient_id")
  chiefComplaint      String              @map("chief_complaint")
  currentIllness      String              @map("current_illness")
  personalAntecedents Json                @map("personal_antecedents")
  familyAntecedents   String?             @map("family_antecedents")
  clinicalExamination String?             @map("clinical_examination")
  diagnoses           Json
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  clinic              Clinic              @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient             Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  treatmentItems      TreatmentPlanItem[]
  attentions          ClinicalAttention[]

  @@unique([clinicId, patientId])
  @@index([clinicId, patientId])
  @@map("clinical_histories")
}

model TreatmentPlanItem {
  id                String              @id @default(uuid())
  clinicId          String              @map("clinic_id")
  clinicalHistoryId String              @map("clinical_history_id")
  procedureId       String              @map("procedure_id")
  procedureCode     String              @map("procedure_code")
  procedureName     String              @map("procedure_name")
  toothNumber       String?             @map("tooth_number")
  status            TreatmentItemStatus @default(PENDING)
  estimatedCostCop  Int                 @map("estimated_cost_cop")
  notes             String?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  clinic            Clinic              @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  clinicalHistory   ClinicalHistory     @relation(fields: [clinicalHistoryId], references: [id], onDelete: Restrict)
  procedure         Procedure           @relation(fields: [procedureId], references: [id], onDelete: Restrict)

  @@index([clinicId, clinicalHistoryId])
  @@map("treatment_plan_items")
}

model Odontogram {
  id                   String               @id @default(uuid())
  clinicId             String               @map("clinic_id")
  patientId            String               @map("patient_id")
  hasTemporalDentition Boolean              @default(false) @map("has_temporal_dentition")
  teethState           Json                 @map("teeth_state")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  clinic               Clinic               @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient              Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  snapshots            OdontogramSnapshot[]

  @@unique([clinicId, patientId])
  @@index([clinicId, patientId])
  @@map("odontograms")
}

model OdontogramSnapshot {
  id                   String     @id @default(uuid())
  clinicId             String     @map("clinic_id")
  patientId            String     @map("patient_id")
  odontogramId         String     @map("odontogram_id")
  hasTemporalDentition Boolean    @map("has_temporal_dentition")
  snapshotData         Json       @map("snapshot_data")
  notes                String?
  createdAt            DateTime   @default(now()) @map("created_at")

  clinic               Clinic     @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient              Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  odontogram           Odontogram @relation(fields: [odontogramId], references: [id], onDelete: Restrict)

  @@index([clinicId, patientId, createdAt])
  @@map("odontogram_snapshots")
}

enum ClinicalAttentionStatus {
  OPEN
  CLOSED
}

model ClinicalAttention {
  id                       String                  @id @default(uuid())
  clinicId                 String                  @map("clinic_id")
  patientId                String                  @map("patient_id")
  clinicalHistoryId        String                  @map("clinical_history_id")
  attendedByUserId         String                  @map("attended_by_user_id")
  status                   ClinicalAttentionStatus @default(OPEN)
  proceduresPerformed      Json                    @map("procedures_performed")
  evolutionNotes           String                  @map("evolution_notes")
  prescription             String?
  postOperativeIndications String?                 @map("post_operative_indications")
  privateNotes             String?                 @map("private_notes")
  attendedAt               DateTime                @map("attended_at")
  createdAt                DateTime                @default(now()) @map("created_at")
  updatedAt                DateTime                @updatedAt @map("updated_at")

  clinic          Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient         Patient                 @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinicalHistory ClinicalHistory         @relation(fields: [clinicalHistoryId], references: [id], onDelete: Restrict)
  attendedByUser  User                    @relation(fields: [attendedByUserId], references: [id], onDelete: Restrict)
  materialsUsed   AttentionMaterialUsed[]

  @@index([clinicId, patientId, attendedAt])
  @@index([clinicId, clinicalHistoryId])
  @@map("clinical_attentions")
}

model AttentionMaterialUsed {
  id          String   @id @default(uuid())
  clinicId    String   @map("clinic_id")
  attentionId String   @map("attention_id")
  materialId  String   @map("material_id")
  brand       String
  reference   String
  type        String
  color       String
  toothNumber String?  @map("tooth_number")
  quantity    Int
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  clinic    Clinic            @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  attention ClinicalAttention @relation(fields: [attentionId], references: [id], onDelete: Restrict)
  material  Material          @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([clinicId, attentionId])
  @@index([clinicId, materialId])
  @@map("attention_materials_used")
}

